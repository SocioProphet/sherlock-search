{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GraphQueryResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["correlation_id", "results"],
  "properties": {
    "correlation_id": {"type": "string"},
    "trace_id": {"type": "string"},
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject", "predicate", "object"],
        "properties": {
          "subject": {"type": "string"},
          "predicate": {"type": "string"},
          "object": {"type": "string"},
          "score": {"type": "number"}
        }
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "kind": {"type": "string", "enum": ["graph"]},
        "version": {"type": "string"}
      }
    }
  }
}
