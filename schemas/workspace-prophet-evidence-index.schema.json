{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.ai/sherlock/schemas/workspace-prophet-evidence-index.schema.json",
  "title": "WorkspaceProphetEvidenceIndex",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "index_id",
    "source_repos",
    "operation_id",
    "capability_id",
    "receipt_id",
    "claim_id",
    "evidence_thread_id",
    "lookup_keys",
    "documents"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "0.1.0" },
    "index_id": { "type": "string", "minLength": 1 },
    "source_repos": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "operation_id": { "type": "string", "minLength": 1 },
    "capability_id": { "type": "string", "minLength": 1 },
    "receipt_id": { "type": "string", "minLength": 1 },
    "claim_id": { "type": "string", "minLength": 1 },
    "evidence_thread_id": { "type": "string", "minLength": 1 },
    "lookup_keys": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "capability_id", "receipt_id", "claim_id"],
      "properties": {
        "operation_id": { "type": "string" },
        "capability_id": { "type": "string" },
        "receipt_id": { "type": "string" },
        "claim_id": { "type": "string" }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document_id", "document_type", "title", "refs"],
        "properties": {
          "document_id": { "type": "string", "minLength": 1 },
          "document_type": { "type": "string", "enum": ["workspace_operation", "scoped_capability", "action_receipt", "claim_record", "evidence_thread"] },
          "title": { "type": "string", "minLength": 1 },
          "refs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "summary": { "type": "string" }
        }
      }
    }
  }
}
