{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.ai/sherlock/schemas/health-ai-search-packet.schema.json",
  "title": "HealthAISearchPacket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_id",
    "readiness_state",
    "production_ready",
    "patient_care_action",
    "source_claim_class",
    "source_refs",
    "contract_refs",
    "search_facets",
    "blocked_from"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "0.1.0" },
    "packet_id": { "type": "string" },
    "readiness_state": { "type": "string", "enum": ["planning_only", "fixture_validated", "runtime_observed", "production_ready"] },
    "production_ready": { "type": "boolean", "const": false },
    "patient_care_action": { "type": "boolean", "const": false },
    "source_claim_class": { "type": "string", "enum": ["external_competitor_claim", "benchmark_design_claim", "socioprophet_validated_claim"] },
    "source_refs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "contract_refs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "search_facets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "health_eval_axes",
        "clinical_value_domains",
        "benchmark_boundary",
        "production_ready",
        "patient_care_action"
      ],
      "properties": {
        "domain": { "type": "string", "const": "health_ai" },
        "health_eval_axes": { "type": "array", "items": { "type": "string" } },
        "clinical_value_domains": { "type": "array", "items": { "type": "string" } },
        "benchmark_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["protected_examples_reproduced", "answer_keys_reproduced", "canary_reproduced"],
          "properties": {
            "protected_examples_reproduced": { "type": "boolean", "const": false },
            "answer_keys_reproduced": { "type": "boolean", "const": false },
            "canary_reproduced": { "type": "boolean", "const": false }
          }
        },
        "production_ready": { "type": "boolean", "const": false },
        "patient_care_action": { "type": "boolean", "const": false }
      }
    },
    "blocked_from": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "summary": { "type": "string" }
  }
}
