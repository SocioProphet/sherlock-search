{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.org/sherlock-search/wallguard-retrieval-filter.schema.json",
  "title": "WallGuard Retrieval Filter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordType",
    "filterId",
    "phase",
    "queryRef",
    "workroomRef",
    "wallRef",
    "subjectRef",
    "wallDecisionRef",
    "wallDecisionOutcome",
    "retrievalDecision",
    "resources",
    "evidenceRefs",
    "policyDecisionRefs"
  ],
  "properties": {
    "schemaVersion": {"const": "sherlock-search.wallguard-retrieval-filter.v0.1"},
    "recordType": {"const": "WallGuardRetrievalFilter"},
    "filterId": {"type": "string", "minLength": 1},
    "phase": {"const": "pre_rank"},
    "queryRef": {"type": "string", "minLength": 1},
    "workroomRef": {"type": "string", "minLength": 1},
    "wallRef": {"type": "string", "minLength": 1},
    "subjectRef": {"type": "string", "minLength": 1},
    "wallDecisionRef": {"type": "string", "minLength": 1},
    "wallDecisionOutcome": {"enum": ["allow", "deny", "redact", "quarantine", "escalate", "clean_room_release_requested", "clean_room_release_allowed", "clean_room_release_denied"]},
    "retrievalDecision": {"enum": ["allow", "deny", "redact", "quarantine", "fail_closed"]},
    "resources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/resource"}},
    "evidenceRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "policyDecisionRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceRef", "resourceWallRef", "visibility", "rankEligible"],
      "properties": {
        "resourceRef": {"type": "string", "minLength": 1},
        "resourceWallRef": {"type": "string", "minLength": 1},
        "visibility": {"enum": ["visible", "redacted", "withheld", "quarantined"]},
        "rankEligible": {"type": "boolean"}
      }
    }
  }
}
